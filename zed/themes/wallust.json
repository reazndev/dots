{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wallust",
  "author": "Antigravity",
  "themes": [
    {
      "name": "Wallust",
      "appearance": "dark",
      "style": {
        "background": "#151717",
        "foreground": "#FCFAE7",
        "editor.background": "#151717",
        "editor.foreground": "#FCFAE7",
        "editor.line_number": "#A9A895",
        "editor.active_line_number": "#9BA296",
        "editor.wrap_guide": "#A9A895",
        "editor.active_line.background": "#202222",
        "border": "#878677",
        "tab.active_background": "#171919",
        "tab.inactive_background": "#141616",
        "tab.active_foreground": "#FCFAE7",
        "tab.inactive_foreground": "#A9A895",
        "title_bar.background": "#141616",
        "status_bar.background": "#141616",
        "pane.background": "#141616",
        "panel.background": "#141616",
        "syntax": {
          "comment": { "color": "#7A889B" },
          "string": { "color": "#98C379" },
          "keyword": { "color": "#C678DD" },
          "function": { "color": "#61AFEF" },
          "type": { "color": "#E5C07B" },
          "number": { "color": "#D19A66" },
          "property": { "color": "#ABB2BF" },
          "constant": { "color": "#D19A66" },
          "operator": { "color": "#56B6C2" }
        }
      }
    }
  ]
}
