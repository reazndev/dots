// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "font": {
      "normal": {
         "family": "Lilex"
      }
   },
   "theme": {
      "dark": {
         "name": "wallust"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 0.98
   },
   "providers": {
      "@mmazzarolo/store.raycast.unicode-symbols": {
         "entrypoints": {
            "index": {
               "alias": "uni"
            }
         }
      },
      "@sovereign/store.vicinae.awww-switcher": {
         "preferences": {
            "wallpaperPath": "/home/reazn/Pictures/Wallpaper",
            "postCommand": "/usr/bin/wallust run \"${wallpaper}\" && python3 /home/reazn/.config/fastfetch/generate_logo_png.py && touch /home/reazn/.config/ghostty/config.ghostty && vicinae theme set wallust && spicetify apply"
         }
      },
      "@thomaslombart/store.raycast.github": {
         "entrypoints": {
            "create-issue": {
               "enabled": false
            },
            "create-pull-request": {
               "enabled": false
            },
            "download-repository": {
               "enabled": false
            },
            "my-issues": {
               "enabled": false
            },
            "my-projects": {
               "enabled": false
            },
            "my-pull-requests": {
               "enabled": false
            },
            "my-starred-repositories": {
               "enabled": true
            },
            "search-pull-requests": {
               "enabled": false
            },
            "search-repositories": {
               "alias": "repo"
            }
         }
      },
      "applications": {
         "entrypoints": {
            "dev.zed.Zed-Preview": {
               "alias": "zd"
            },
            "helium": {
               "alias": "h"
            }
         }
      },
      "clipboard": {
         "entrypoints": {
            "history": {
               "alias": "k"
            }
         }
      },
      "core": {
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
               "enabled": false
            },
            "keybind-settings": {
               "enabled": false
            },
            "list-extensions": {
               "enabled": false
            },
            "manage-fallback": {
               "enabled": false
            },
            "oauth-token-store": {
               "enabled": false
            },
            "refresh-apps": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "settings": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            }
         }
      }
   }
}