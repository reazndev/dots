/**
 * @name Wallust
 * @author reazn
 * @description Vesktop theme generated from Wallust colors.
 * @version 1.0.0
 */

:root,
.theme-dark,
.visual-refresh,
.visual-refresh.theme-dark,
#app-mount .theme-dark {
  --wallust-bg: {{background | darken(0.08)}};
  --wallust-bg-deep: {{background | darken(0.14)}};
  --wallust-surface: {{background | darken(0.04)}};
  --wallust-surface-alt: {{background | lighten(0.04)}};
  --wallust-surface-hover: {{background | lighten(0.08)}};
  --wallust-bg-opacity: 97%;
  --wallust-surface-opacity: 94%;
  --wallust-bg-blur: 18px;
  --wallust-bg-alpha: color-mix(in srgb, var(--wallust-bg) var(--wallust-bg-opacity), transparent);
  --wallust-bg-deep-alpha: color-mix(in srgb, var(--wallust-bg-deep) var(--wallust-bg-opacity), transparent);
  --wallust-surface-alpha: color-mix(in srgb, var(--wallust-surface) var(--wallust-surface-opacity), transparent);
  --wallust-surface-alt-alpha: color-mix(in srgb, var(--wallust-surface-alt) var(--wallust-surface-opacity), transparent);
  --wallust-border: {{color8 | darken(0.2)}};
  --wallust-text: {{foreground}};
  --wallust-text-muted: {{color8}};
  --wallust-accent: {{color4}};
  --wallust-accent-hover: {{color12}};
  --wallust-accent-text: {{background}};
  --wallust-danger: {{color1}};
  --wallust-success: {{color2}};
  --wallust-warning: {{color3}};
  --wallust-info: {{color5}};

  --background-primary: var(--wallust-bg-alpha);
  --background-secondary: var(--wallust-surface-alpha);
  --background-secondary-alt: var(--wallust-bg-deep-alpha);
  --background-tertiary: var(--wallust-bg-deep-alpha);
  --background-accent: var(--wallust-accent);
  --background-floating: var(--wallust-surface-alpha);
  --background-modifier-hover: color-mix(in srgb, var(--wallust-surface-hover) 78%, transparent);
  --background-modifier-active: color-mix(in srgb, var(--wallust-accent) 22%, var(--wallust-surface));
  --background-modifier-selected: color-mix(in srgb, var(--wallust-accent) 18%, var(--wallust-surface));
  --background-modifier-accent: var(--wallust-border);

  --bg-base-primary: var(--wallust-bg-alpha);
  --bg-base-secondary: var(--wallust-surface-alpha);
  --bg-base-tertiary: var(--wallust-bg-deep-alpha);
  --bg-surface-raised: var(--wallust-surface-alpha);
  --bg-surface-overlay: var(--wallust-surface-alpha);
  --bg-surface-overlay-tmp: var(--wallust-surface-alpha);
  --bg-surface-higher: var(--wallust-surface-alt-alpha);
  --bg-surface-high: var(--wallust-surface-alpha);
  --bg-surface-low: var(--wallust-bg-alpha);
  --bg-surface-lowest: var(--wallust-bg-deep-alpha);
  --background-base-lowest: var(--wallust-bg-deep-alpha);
  --background-base-lower: var(--wallust-bg-alpha);
  --background-base-low: var(--wallust-bg-alpha);
  --background-surface-highest: var(--wallust-surface-hover);
  --background-surface-higher: var(--wallust-surface-alt-alpha);
  --background-surface-high: var(--wallust-surface-alpha);
  --background-surface-low: var(--wallust-bg-alpha);
  --background-surface-lower: var(--wallust-bg-deep-alpha);
  --background-surface-lowest: var(--wallust-bg-deep-alpha);
  --app-background-frame: var(--wallust-bg-deep-alpha);
  --app-background: var(--wallust-bg-alpha);
  --custom-app-top-bar-background: var(--wallust-bg-deep-alpha);
  --custom-channel-members-bg: var(--wallust-bg-alpha);
  --custom-guild-list-background: var(--wallust-bg-deep-alpha);
  --custom-sidebar-background: var(--wallust-bg-alpha);
  --custom-chat-input-margin-bottom: 24px;

  --border-faint: color-mix(in srgb, var(--wallust-border) 35%, transparent);
  --border-subtle: color-mix(in srgb, var(--wallust-border) 55%, transparent);
  --border-normal: var(--wallust-border);
  --border-strong: var(--wallust-text-muted);

  --channeltextarea-background: var(--wallust-surface-alpha);
  --input-background: var(--wallust-surface-alpha);
  --input-border: var(--wallust-border);
  --modal-background: var(--wallust-bg-alpha);
  --modal-footer-background: var(--wallust-bg-deep-alpha);
  --card-primary-bg: var(--wallust-surface-alpha);
  --card-secondary-bg: var(--wallust-bg-alpha);
  --spoiler-hidden-background: var(--wallust-surface-hover);
  --profile-body-background-color: var(--wallust-bg-alpha);
  --profile-gradient-primary-color: var(--wallust-bg-alpha);
  --profile-gradient-secondary-color: var(--wallust-surface-alpha);

  --text-normal: var(--wallust-text);
  --text-primary: var(--wallust-text);
  --text-secondary: var(--wallust-text-muted);
  --text-tertiary: var(--wallust-text-muted);
  --text-muted: var(--wallust-text-muted);
  --text-link: var(--wallust-info);
  --header-primary: var(--wallust-text);
  --header-secondary: var(--wallust-text-muted);
  --interactive-normal: var(--wallust-text);
  --interactive-hover: var(--wallust-accent-hover);
  --interactive-active: var(--wallust-accent);
  --interactive-muted: var(--wallust-text-muted);

  --brand-360: var(--wallust-accent);
  --brand-400: var(--wallust-accent);
  --brand-460: var(--wallust-accent);
  --brand-500: var(--wallust-accent);
  --brand-560: var(--wallust-accent-hover);
  --brand-600: var(--wallust-accent-hover);
  --button-positive-background: var(--wallust-success);
  --button-danger-background: var(--wallust-danger);
  --status-danger: var(--wallust-danger);
  --status-positive: var(--wallust-success);
  --status-warning: var(--wallust-warning);
}

