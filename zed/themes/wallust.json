{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wallust",
  "author": "Antigravity",
  "themes": [
    {
      "name": "Wallust",
      "appearance": "dark",
      "style": {
        "background": "#1A1616",
        "foreground": "#EFD9D5",
        "editor.background": "#1A1616",
        "editor.foreground": "#EFD9D5",
        "editor.line_number": "#9D8683",
        "editor.active_line_number": "#495F76",
        "editor.wrap_guide": "#9D8683",
        "editor.active_line.background": "#262121",
        "border": "#7E6B69",
        "tab.active_background": "#1D1818",
        "tab.inactive_background": "#1A1515",
        "tab.active_foreground": "#EFD9D5",
        "tab.inactive_foreground": "#9D8683",
        "title_bar.background": "#1A1515",
        "status_bar.background": "#1A1515",
        "pane.background": "#1A1515",
        "panel.background": "#1A1515",
        "syntax": {
          "comment": { "color": "#7A889B" },
          "string": { "color": "#98C379" },
          "keyword": { "color": "#C678DD" },
          "function": { "color": "#61AFEF" },
          "type": { "color": "#E5C07B" },
          "number": { "color": "#D19A66" },
          "property": { "color": "#ABB2BF" },
          "constant": { "color": "#D19A66" },
          "operator": { "color": "#56B6C2" }
        }
      }
    }
  ]
}
