# Starship config template generated by Wallust

# Set up format
format = """
$directory\
$git_branch\
$git_status\
$character"""

[directory]
style = "bold {{color4}}"
format = "[$path]($style) "
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = " "
style = "bold {{color5}}"
format = "on [$symbol$branch]($style) "

[git_status]
style = "bold {{color3}}"
format = "[\\[$all_status$ahead_behind\\]]($style) "

[character]
success_symbol = "[➜](bold {{color2}}) "
error_symbol = "[➜](bold {{color1}}) "
