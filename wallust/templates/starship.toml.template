# Starship config template generated by Wallust

format = """
$directory$git_status
$character"""

add_newline = false

[directory]
style = "bold {{color4}}"
format = "[$path]($style)"
truncation_length = 0
truncate_to_repo = false

[git_status]
format = " $ahead_behind$staged$modified$untracked$deleted$renamed$stashed"
ahead = "[↑$count](bold {{color2}})"
behind = "[↓$count](bold {{color1}})"
diverged = "[↑$ahead_count↓$behind_count](bold {{color1}})"
staged = "[\\[$count staged\\]](bold {{color2}})"
modified = "[\\[~$count\\]](bold {{color5}})"
untracked = "[\\[?$count\\]](bold {{color3}})"
deleted = "[\\[✗$count\\]](bold {{color1}})"
renamed = "[\\[»$count\\]](bold {{color3}})"
stashed = "[\\[≡$count stashed\\]](bold {{color4}})"
ignore_submodules = true

[character]
success_symbol = "\n[->](bold {{color2}}) "
error_symbol = "\n[->](bold {{color1}}) "
vicmd_symbol = "\n[->](bold {{color4}}) "
