{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/reazn/.config/fastfetch/logo.txt",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "34" // Cyan/Blue
    },
    {
      "type": "host",
      "key": "Host ",
      "keyColor": "35" // Purple/Magenta
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "36" // Light Cyan
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "32" // Green
    },
    {
      "type": "packages",
      "key": "Pkgs  ",
      "keyColor": "33" // Yellow
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "34"
    },
    {
      "type": "wm",
      "key": "WM    ",
      "keyColor": "35"
    },
    {
      "type": "terminal",
      "key": "Term  ",
      "keyColor": "36"
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      "keyColor": "32"
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "keyColor": "33"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "34"
    },
    "break",
    "colors"
  ]
}
