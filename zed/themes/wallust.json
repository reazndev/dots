{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wallust",
  "author": "Antigravity",
  "themes": [
    {
      "name": "Wallust",
      "appearance": "dark",
      "style": {
        "background": "#252225",
        "foreground": "#FCFBF0",
        "editor.background": "#252225",
        "editor.foreground": "#FCFBF0",
        "editor.line_number": "#AAA89E",
        "editor.active_line_number": "#C58D3C",
        "editor.wrap_guide": "#AAA89E",
        "editor.active_line.background": "#322F32",
        "border": "#88867E",
        "tab.active_background": "#292629",
        "tab.inactive_background": "#242124",
        "tab.active_foreground": "#FCFBF0",
        "tab.inactive_foreground": "#AAA89E",
        "title_bar.background": "#242124",
        "status_bar.background": "#242124",
        "pane.background": "#242124",
        "panel.background": "#242124",
        "syntax": {
          "comment": { "color": "#7A889B" },
          "string": { "color": "#98C379" },
          "keyword": { "color": "#C678DD" },
          "function": { "color": "#61AFEF" },
          "type": { "color": "#E5C07B" },
          "number": { "color": "#D19A66" },
          "property": { "color": "#ABB2BF" },
          "constant": { "color": "#D19A66" },
          "operator": { "color": "#56B6C2" }
        }
      }
    }
  ]
}
