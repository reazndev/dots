{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/reazn/.config/fastfetch/logo.png",
    "type": "kitty",
    "width": 38,
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS    ",
      "keyColor": "34"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "32"
    },
    {
      "type": "packages",
      "key": "Pkgs  ",
      "keyColor": "33"
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "34"
    },
    {
      "type": "wm",
      "key": "WM    ",
      "keyColor": "35"
    },
    {
      "type": "terminal",
      "key": "Term  ",
      "keyColor": "36"
    },
    {
      "type": "display",
      "key": "Res   ",
      "keyColor": "32",
      "compactType": "original"
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      "keyColor": "33"
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      "keyColor": "35"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "34"
    },
    {
      "type": "media",
      "key": "Now   ",
      "keyColor": "32",
      "format": "{title} - {artist}"
    },
    "break",
    "colors"
  ]
}
