{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wallust",
  "author": "Antigravity",
  "themes": [
    {
      "name": "Wallust",
      "appearance": "dark",
      "style": {
        "background": "#21202B",
        "foreground": "#E4FDFC",
        "editor.background": "#21202B",
        "editor.foreground": "#E4FDFC",
        "editor.line_number": "#92AAAA",
        "editor.active_line_number": "#30A0CB",
        "editor.wrap_guide": "#92AAAA",
        "editor.active_line.background": "#2E2C38",
        "border": "#758888",
        "tab.active_background": "#252330",
        "tab.inactive_background": "#211F2A",
        "tab.active_foreground": "#E4FDFC",
        "tab.inactive_foreground": "#92AAAA",
        "title_bar.background": "#211F2A",
        "status_bar.background": "#211F2A",
        "pane.background": "#211F2A",
        "panel.background": "#211F2A",
        "syntax": {
          "comment": { "color": "#7A889B" },
          "string": { "color": "#98C379" },
          "keyword": { "color": "#C678DD" },
          "function": { "color": "#61AFEF" },
          "type": { "color": "#E5C07B" },
          "number": { "color": "#D19A66" },
          "property": { "color": "#ABB2BF" },
          "constant": { "color": "#D19A66" },
          "operator": { "color": "#56B6C2" }
        }
      }
    }
  ]
}
