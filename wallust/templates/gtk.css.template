/* ==============================================================================
 * GTK-3, GTK-4 & Libadwaita Color Overrides - Generated by Wallust
 * ============================================================================== */

/* GTK 3 Core Variables */
@define-color theme_bg_color {{background | darken(0.08)}};
@define-color theme_fg_color {{foreground}};
@define-color theme_base_color {{background | darken(0.12)}};
@define-color theme_alternate_base_color {{background | lighten(0.1)}};
@define-color theme_text_color {{foreground}};
@define-color theme_selected_bg_color {{color4}};
@define-color theme_selected_fg_color {{background}};
@define-color theme_view_bg_color {{background | darken(0.12)}};
@define-color theme_view_alternate_bg_color {{background | lighten(0.1)}};
@define-color theme_view_text_color {{foreground}};
@define-color theme_header_background {{background | darken(0.12)}};
@define-color theme_header_foreground {{foreground}};
@define-color theme_sidebar_background {{background | darken(0.12)}};
@define-color theme_sidebar_foreground {{foreground}};

/* GTK 3 Muted States & Borders */
@define-color insensitive_bg_color {{background | darken(0.04)}};
@define-color insensitive_fg_color {{color8}};
@define-color insensitive_base_color {{background | darken(0.04)}};
@define-color borders {{color8 | darken(0.2)}};
@define-color outline {{color8 | darken(0.2)}};

/* GTK 4 / Libadwaita Core Overrides */
@define-color window_bg_color {{background | darken(0.08)}};
@define-color window_fg_color {{foreground}};
@define-color view_bg_color {{background | darken(0.12)}};
@define-color view_alternate_bg_color {{background | lighten(0.1)}};
@define-color view_fg_color {{foreground}};
@define-color headerbar_bg_color {{background | darken(0.12)}};
@define-color headerbar_fg_color {{foreground}};
@define-color sidebar_bg_color {{background | darken(0.12)}};
@define-color sidebar_fg_color {{foreground}};
@define-color card_bg_color {{background | darken(0.04)}};
@define-color card_fg_color {{foreground}};
@define-color popover_bg_color {{background | darken(0.04)}};
@define-color popover_fg_color {{foreground}};

/* Libadwaita Selection & Accent Highlights */
@define-color accent_color {{color4}};
@define-color accent_bg_color {{color4}};
@define-color accent_fg_color {{background}};

/* Keep Qt's GTK platform theme from exporting the wrong AlternateBase. */
treeview.view,
treeview.view row,
list,
list row {
  background-color: @theme_base_color;
  color: @theme_text_color;
}

treeview.view row:nth-child(even),
list row:nth-child(even) {
  background-color: @theme_alternate_base_color;
  color: @theme_text_color;
}
