# ==============================================================================
# Whitelist-only .gitignore for Safe, Sensitive-free Dotfiles Management
# ==============================================================================

# 1. Ignore everything by default
*

# 2. Allow this .gitignore file
!.gitignore

# ==============================================================================
# ALLOWED DIRECTORIES AND FILES
# ==============================================================================

# Starship shell prompt config
!starship.toml

# Hyprland window manager configurations
!hypr/
hypr/*
!hypr/*.lua

# Wallust theme template generator configurations
!wallust/
wallust/*
!wallust/wallust.toml
!wallust/templates/
wallust/templates/*
!wallust/templates/*.template

# Quickshell desktop shell bar widget files
!quickshell/
quickshell/**
!quickshell/**/
!quickshell/**/*.qml
!quickshell/**/*.js
!quickshell/**/*.py
!quickshell/**/*.json
!quickshell/**/qmldir
!quickshell/**/*.png
!quickshell/**/*.svg
!quickshell/**/*.conf
!quickshell/**/.gitignore
!quickshell/**/Cargo.toml
!quickshell/**/Cargo.lock
!quickshell/**/*.rs
quickshell/**/target/

# Sensitive: usage tracking API tokens
quickshell/usage.json

# Ghostty terminal configurations
!ghostty/
ghostty/*
!ghostty/config
!ghostty/config.ghostty
!ghostty/themes/
ghostty/themes/*
!ghostty/themes/wallust

# Kitty terminal configurations
!kitty/
kitty/*
!kitty/kitty.conf
!kitty/theme.conf

# Fish shell configurations
!fish/
fish/*
!fish/config.fish
!fish/functions/
fish/functions/*
!fish/functions/*.fish

# Zed editor configurations & themes
!zed/
zed/*
!zed/settings.json
!zed/themes/
zed/themes/*
!zed/themes/wallust.json

# Vicinae extension settings
!vicinae/
vicinae/*
!vicinae/settings.json

# Vesktop / Vencord theme settings
!vesktop/
vesktop/*
!vesktop/settings/
vesktop/settings/*
!vesktop/settings/settings.json
!vesktop/themes/
vesktop/themes/*
!vesktop/themes/wallust.css

# GTK-3.0 & GTK-4.0 configurations
!gtk-3.0/
gtk-3.0/*
!gtk-3.0/gtk.css
!gtk-3.0/settings.ini

!gtk-4.0/
gtk-4.0/*
!gtk-4.0/gtk.css
!gtk-4.0/settings.ini

# KDE / Dolphin / QT configuration
!kdeglobals

# Fastfetch configurations
!fastfetch/
fastfetch/*
!fastfetch/config.jsonc
!fastfetch/logo.txt
!fastfetch/generate_logo_png.py

!icons/
!icons/**
